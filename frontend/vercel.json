{
  "version": 2,
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/register",
      "dest": "/register.html"
    },
    {
      "src": "/todo",
      "dest": "/todo.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}